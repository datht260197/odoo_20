<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         IT ASSET: FORM VIEW
    ==================================================================== -->
    <record id="view_it_asset_form" model="ir.ui.view">
        <field name="name">it.asset.form</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <form string="Tài sản CNTT">

                <!-- Header: Statusbar + Action Buttons (chỉ IT Manager thao tác) -->
                <header>
                    <button name="action_set_in_use"
                            string="Cấp phát / Sử dụng"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'in_use'"
                            groups="it_helpdesk.group_it_manager"/>
                    <button name="action_set_repairing"
                            string="Gửi sửa chữa"
                            type="object"
                            invisible="state in ['repairing', 'disposed']"
                            groups="it_helpdesk.group_it_manager"/>
                    <button name="action_set_in_stock"
                            string="Nhập kho"
                            type="object"
                            invisible="state in ['in_stock', 'disposed']"
                            groups="it_helpdesk.group_it_manager"/>
                    <button name="action_set_disposed"
                            string="Thanh lý"
                            type="object"
                            invisible="state == 'disposed'"
                            groups="it_helpdesk.group_it_manager"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="in_stock,in_use,repairing,disposed"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-ticket">
                            <field name="ticket_count" widget="statinfo" string="Phiếu hỗ trợ"/>
                        </button>
                    </div>

                    <!-- Tên thiết bị -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Tên thiết bị hoặc mã tài sản..."/>
                        </h1>
                    </div>

                    <!-- Thông tin chính chia 2 cột -->
                    <group>
                        <group string="Thông tin thiết bị">
                            <field name="category_type"/>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="serial_number"/>
                        </group>
                        <group string="Thông tin cấp phát &amp; bảo hành">
                            <field name="employee_id"
                                   options="{'no_create': True}"
                                   required="state == 'in_use'"/>
                            <field name="date_assigned"/>
                            <field name="purchase_date"/>
                            <field name="warranty_expiry"/>
                        </group>
                    </group>

                    <!-- Ghi chú và phiếu liên quan -->
                    <notebook>
                        <page string="Ghi chú" name="notes">
                            <field name="notes"
                                   placeholder="Ghi chú về tình trạng, cấu hình hoặc lịch sử thiết bị..."/>
                        </page>
                        <page string="Phiếu hỗ trợ liên quan" name="tickets">
                            <field name="ticket_ids" readonly="1">
                                <list string="Phiếu hỗ trợ">
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="assignee_id"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-info="state == 'new'"
                                           decoration-warning="state == 'waiting'"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state == 'cancelled'"
                                           decoration-primary="state == 'in_progress'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ====================================================================
         IT ASSET: LIST VIEW
    ==================================================================== -->
    <record id="view_it_asset_tree" model="ir.ui.view">
        <field name="name">it.asset.list</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <list string="Danh sách tài sản CNTT"
                  decoration-success="state == 'in_use'"
                  decoration-info="state == 'in_stock'"
                  decoration-warning="state == 'repairing'"
                  decoration-muted="state == 'disposed'">
                <field name="name"/>
                <field name="category_type"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="serial_number"/>
                <field name="employee_id"/>
                <field name="warranty_expiry"
                       decoration-danger="warranty_expiry and warranty_expiry &lt; current_date"/>
                <field name="ticket_count" string="# Phiếu"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'in_use'"
                       decoration-info="state == 'in_stock'"
                       decoration-warning="state == 'repairing'"
                       decoration-muted="state == 'disposed'"/>
            </list>
        </field>
    </record>

    <!-- ====================================================================
         IT ASSET: KANBAN VIEW
    ==================================================================== -->
    <record id="view_it_asset_kanban" model="ir.ui.view">
        <field name="name">it.asset.kanban</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <kanban string="Kanban tài sản CNTT"
                    default_group_by="state"
                    group_create="false"
                    class="o_kanban_small_column">
                <field name="name"/>
                <field name="category_type"/>
                <field name="brand"/>
                <field name="serial_number"/>
                <field name="employee_id"/>
                <field name="state"/>
                <field name="color"/>
                <field name="ticket_count"/>
                <templates>
                    <t t-name="menu">
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click
                                           #{record.color.raw_value ? 'oe_kanban_color_' + record.color.raw_value : ''}">
                            <div class="oe_kanban_top_color"/>
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="category_type"/>
                                        <t t-if="record.brand.raw_value">
                                            - <field name="brand"/>
                                        </t>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.serial_number.raw_value" class="text-muted">
                                    <i class="fa fa-barcode"/> <field name="serial_number"/>
                                </div>
                                <div t-if="record.employee_id.raw_value" class="mt4">
                                    <i class="fa fa-user"/> <field name="employee_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.ticket_count.raw_value > 0"
                                          class="badge badge-warning">
                                        <i class="fa fa-ticket"/> <field name="ticket_count"/> phiếu
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ====================================================================
         IT ASSET: SEARCH VIEW
    ==================================================================== -->
    <record id="view_it_asset_search" model="ir.ui.view">
        <field name="name">it.asset.search</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm tài sản CNTT">
                <field name="name" string="Tên / Mã tài sản"/>
                <field name="serial_number" string="Số Serial"/>
                <field name="employee_id" string="Nhân viên sử dụng"/>
                <field name="brand" string="Thương hiệu"/>
                <separator/>
                <filter name="filter_in_use"
                        string="Đang sử dụng"
                        domain="[('state', '=', 'in_use')]"/>
                <filter name="filter_in_stock"
                        string="Trong kho"
                        domain="[('state', '=', 'in_stock')]"/>
                <filter name="filter_repairing"
                        string="Đang sửa chữa"
                        domain="[('state', '=', 'repairing')]"/>
                <filter name="filter_disposed"
                        string="Đã thanh lý"
                        domain="[('state', '=', 'disposed')]"/>
                <separator/>
                <filter name="filter_laptop"
                        string="Laptop"
                        domain="[('category_type', '=', 'laptop')]"/>
                <filter name="filter_desktop"
                        string="Máy bàn"
                        domain="[('category_type', '=', 'desktop')]"/>
                <filter name="filter_network"
                        string="Thiết bị mạng"
                        domain="[('category_type', '=', 'network')]"/>
                <group>
                    <filter name="group_state"
                            string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_category"
                            string="Loại thiết bị"
                            context="{'group_by': 'category_type'}"/>
                    <filter name="group_employee"
                            string="Nhân viên sử dụng"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_brand"
                            string="Thương hiệu"
                            context="{'group_by': 'brand'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ====================================================================
         ACTION: it.asset
    ==================================================================== -->
    <record id="action_it_asset" model="ir.actions.act_window">
        <field name="name">Tài sản CNTT</field>
        <field name="res_model">it.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_in_use': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm tài sản CNTT đầu tiên!
            </p>
            <p>
                Quản lý toàn bộ thiết bị CNTT: laptop, máy bàn, màn hình,
                máy in và thiết bị mạng. Theo dõi cấp phát và trạng thái sử dụng.
            </p>
        </field>
    </record>

    <!-- ====================================================================
         MENU ITEMS: Tài sản CNTT
         (khai báo ở đây sau khi action_it_asset được định nghĩa ở trên)
    ==================================================================== -->
    <menuitem id="menu_it_asset_from_ticket"
              name="Tài sản CNTT"
              parent="menu_it_helpdesk_config"
              action="action_it_asset"
              sequence="40"
              groups="it_helpdesk.group_it_user"/>

</odoo>
