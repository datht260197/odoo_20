<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    ============================================================================
    CẤU HÌNH THAM SỐ HỆ THỐNG (System Parameters) cho Telegram Bot
    ============================================================================
    Sau khi cài module, admin vào:
      Settings → Technical → Parameters → System Parameters
    Và cập nhật giá trị thực cho 3 khóa bên dưới.
    ============================================================================
    -->

    <!-- 1. Bật/tắt tính năng Telegram (True / False) -->
    <record id="param_telegram_enabled" model="ir.config_parameter">
        <field name="key">it_helpdesk.telegram_enabled</field>
        <field name="value">False</field>
    </record>

    <!-- 2. Token của Telegram Bot (lấy từ @BotFather trên Telegram) -->
    <record id="param_telegram_bot_token" model="ir.config_parameter">
        <field name="key">it_helpdesk.telegram_bot_token</field>
        <field name="value">YOUR_BOT_TOKEN_HERE</field>
    </record>

    <!-- 3. Chat ID của nhóm IT nhận thông báo
         Lấy bằng cách:
           a. Mời bot vào nhóm Telegram của team IT
           b. Gửi tin nhắn bất kỳ trong nhóm
           c. Gọi: https://api.telegram.org/bot<TOKEN>/getUpdates
           d. Tìm trường "chat" → "id" (thường là số âm cho group)
    -->
    <record id="param_telegram_chat_id" model="ir.config_parameter">
        <field name="key">it_helpdesk.telegram_chat_id</field>
        <field name="value">YOUR_CHAT_ID_HERE</field>
    </record>

</odoo>
