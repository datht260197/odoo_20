<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Concrete Construction Project Stages -->
    <record id="rmc_project_stage_prep" model="project.project.stage">
        <field name="sequence">1</field>
        <field name="name">1. Site Preparation</field>
    </record>

    <record id="rmc_project_stage_lean" model="project.project.stage">
        <field name="sequence">2</field>
        <field name="name">2. Lean Concrete Pouring</field>
    </record>

    <record id="rmc_project_stage_foundation" model="project.project.stage">
        <field name="sequence">3</field>
        <field name="name">3. Foundation / Basement Pouring</field>
    </record>

    <record id="rmc_project_stage_structure" model="project.project.stage">
        <field name="sequence">4</field>
        <field name="name">4. Structural Superstructure Pouring</field>
    </record>

    <record id="rmc_project_stage_acceptance" model="project.project.stage">
        <field name="sequence">5</field>
        <field name="name">5. Final Acceptance &amp; Settlement</field>
        <field name="fold" eval="True"/>
    </record>
</odoo>
