<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Project Form View -->
    <record id="project_project_rmc_form" model="ir.ui.view">
        <field name="name">project.project.rmc.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="is_concrete_site"/>
                <field name="project_code" invisible="not is_concrete_site"/>
                <field name="fast_legacy_project_code" invisible="not is_concrete_site"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="rmc_site_details" string="Concrete Site Hub" invisible="not is_concrete_site">
                    <group>
                        <group string="GPS Coordinates &amp; Geofence" name="gps_geofence_group">
                            <field name="site_address"/>
                            <field name="gps_latitude"/>
                            <field name="gps_longitude"/>
                            <field name="geofence_radius_m"/>
                        </group>
                        <group string="Batching Plant Routing" name="plant_routing_group">
                            <field name="primary_plant_id"/>
                            <field name="backup_plant_ids" widget="many2many_tags"/>
                            <field name="account_id" string="Analytic Account" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pouring Quotas &amp; Progress Metrics" name="quota_metrics_group">
                        <group>
                            <field name="total_contract_quota_m3"/>
                            <field name="total_delivered_m3"/>
                            <field name="remaining_quota_m3"/>
                        </group>
                        <group>
                            <field name="completion_progress" widget="progressbar"/>
                            <field name="transport_violation_count"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Project List View -->
    <record id="project_project_rmc_tree" model="ir.ui.view">
        <field name="name">project.project.rmc.list</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_concrete_site" optional="show"/>
                <field name="project_code" optional="show"/>
                <field name="primary_plant_id" optional="show"/>
                <field name="total_contract_quota_m3" optional="hide"/>
                <field name="total_delivered_m3" optional="hide"/>
                <field name="remaining_quota_m3" optional="show"/>
                <field name="completion_progress" widget="progressbar" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Filter action for Concrete Construction Sites -->
    <record id="action_rmc_concrete_sites" model="ir.actions.act_window">
        <field name="name">Concrete Construction Sites</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_concrete_site', '=', True)]</field>
        <field name="context">{'default_is_concrete_site': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new Concrete Construction Site
            </p>
            <p>
                Configure GPS discharge coordinates, geofence radius, and assign primary/backup batching plants.
            </p>
        </field>
    </record>

    <!-- Menu item under Project Management -->
    <menuitem
        id="menu_rmc_concrete_sites"
        name="Construction Sites"
        action="action_rmc_concrete_sites"
        parent="project.menu_main_pm"
        sequence="3"/>
</odoo>
