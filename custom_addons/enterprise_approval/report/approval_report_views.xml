<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: A4 Portrait with Official Corporate Margins -->
    <record id="paperformat_approval_slip" model="report.paperformat">
        <field name="name">Approval Slip A4 Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">96</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_approval_slip" model="ir.actions.report">
        <field name="name">Phiếu phê duyệt</field>
        <field name="model">approval.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">enterprise_approval.report_approval_slip_template</field>
        <field name="paperformat_id" ref="paperformat_approval_slip"/>
        <field name="print_report_name">'Phieu_phe_duyet_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_approval_request"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
