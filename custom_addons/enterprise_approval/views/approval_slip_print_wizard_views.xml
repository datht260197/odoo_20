<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_slip_print_wizard_form" model="ir.ui.view">
        <field name="name">approval.slip.print.wizard.form</field>
        <field name="model">approval.slip.print.wizard</field>
        <field name="arch" type="xml">
            <form string="In phiếu phê duyệt">
                <sheet>
                    <field name="request_id" invisible="1"/>
                    <group>
                        <group string="Tùy chọn in ấn">
                            <field name="print_watermark" widget="boolean_toggle"/>
                            <field name="include_digital_signatures" widget="boolean_toggle"/>
                            <field name="include_approval_comments" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Ghi chú in bổ sung">
                        <field name="custom_notes"
                               nolabel="1"
                               placeholder="Nhập các ghi chú hoặc điều khoản bổ sung để in ở chân trang tài liệu..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_slip"
                            string="In phiếu PDF"
                            type="object"
                            class="btn-primary"/>
                    <button string="Hủy"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
