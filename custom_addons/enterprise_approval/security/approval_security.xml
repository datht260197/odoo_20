<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ====================================================================
             PHÂN HỆ BẢO MẬT: PHÊ DUYỆT DOANH NGHIỆP
             ==================================================================== -->
        <record id="module_category_enterprise_approval" model="ir.module.category">
            <field name="name">Enterprise Approval</field>
            <field name="description">Manage enterprise requests and approval workflows</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_enterprise_approval" model="res.groups.privilege">
            <field name="name">Enterprise Approval</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="module_category_enterprise_approval"/>
        </record>

        <!-- Nhóm 1: Nhân viên (Tạo, sửa nháp, nộp duyệt và theo dõi đơn cá nhân) -->
        <record id="group_approval_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_enterprise_approval"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users can create, edit drafts, submit and track their own approval requests.</field>
        </record>

        <!-- Nhóm 2: Người phê duyệt (Xem xét, phê duyệt hoặc từ chối đơn được giao) -->
        <record id="group_approval_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_enterprise_approval"/>
            <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
            <field name="comment">Can view assigned approval requests and approve or reject them.</field>
        </record>

        <!-- Nhóm 3: Quản trị viên (Toàn quyền quản trị phân hệ) -->
        <record id="group_approval_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_enterprise_approval"/>
            <field name="implied_ids" eval="[(4, ref('group_approval_approver'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full administrative access to all approval categories, workflow stages, and requests.</field>
        </record>

    </data>
</odoo>
