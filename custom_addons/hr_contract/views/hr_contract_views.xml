<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action from Employee to Contracts -->
    <record id="act_hr_employee_2_hr_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_employee_id': [active_id],
            'default_employee_id': active_id,
            'search_default_group_by_state': 1
        }</field>
    </record>

    <!-- Extend Employee Form with Contract Stat Button & Details -->
    <record id="hr_hr_employee_view_form2" model="ir.ui.view">
        <field name="name">hr.hr.employee.view.form2</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_contract"
                    class="oe_stat_button"
                    icon="contact_page"
                    type="object"
                    groups="hr.group_hr_user"
                    invisible="not id">
                    <field name="contracts_count" widget="statinfo" string="Contracts"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="contracts" string="Contracts" groups="hr.group_hr_user">
                    <group name="contract_summary">
                        <group string="Current Contract" name="current_contract_info">
                            <field name="contract_id" readonly="1" options="{'no_open': False}"/>
                            <field name="medic_exam"/>
                        </group>
                        <group string="Commute &amp; Vehicle" name="commute_info">
                            <field name="vehicle"/>
                            <field name="vehicle_distance"/>
                        </group>
                    </group>
                    <separator string="Contract History"/>
                    <field name="contract_ids" readonly="1">
                        <list string="Contracts" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-warning="state == 'pending'" decoration-muted="state == 'close'">
                            <field name="name"/>
                            <field name="type_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="wage"/>
                            <field name="word_template_id" optional="show"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-warning="state == 'pending'" decoration-muted="state == 'close'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- HR Contract Search View -->
    <record id="hr_contract_view_search" model="ir.ui.view">
        <field name="name">hr.contract.search</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contract">
                <field name="name" string="Contract Reference"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="type_id"/>
                <field name="word_template_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Running" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="To Renew" name="to_renew" domain="[('state', '=', 'pending')]"/>
                <filter string="Expired" name="close" domain="[('state', '=', 'close')]"/>
                <separator/>
                <filter string="Current Employee" name="current_employee" domain="[('employee_id.active', '=', True)]"/>
                <separator/>
                <filter string="Employee" name="group_by_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                <filter string="Job Position" name="group_by_job" domain="[]" context="{'group_by': 'job_id'}"/>
                <filter string="Contract Type" name="group_by_type" domain="[]" context="{'group_by': 'type_id'}"/>
                <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- HR Contract Form View with Document Canvas styling -->
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <form string="Employee Contract" class="o_contract_document_form">
                <header>
                    <button name="action_print_docx_contract"
                        string="In Hợp đồng (Word)"
                        type="object"
                        class="btn-primary"
                        icon="fa-file-word-o"
                        help="Generate and download a populated Word (.docx) document based on the selected template."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,pending,close"/>
                </header>
                <sheet>
                    <div class="oe_title" name="title">
                        <label for="name" string="Contract Reference"/>
                        <h1>
                            <field name="name" placeholder="e.g. HĐLĐ-2026/001"/>
                        </h1>
                    </div>
                    <group>
                        <group name="employee_info">
                            <field name="employee_id" required="1"/>
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="contract_meta">
                            <field name="type_id" required="1"/>
                            <field name="word_template_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary &amp; Compensation" name="salary_info">
                            <group name="main_info">
                                <group name="salary_group" string="Monthly Base Wage">
                                    <label for="wage"/>
                                    <div class="o_row" name="wage">
                                        <field name="wage" class="oe_inline" nolabel="1"/>
                                        <span class="text-muted">/ month</span>
                                    </div>
                                    <field name="advantages" placeholder="Additional advantages or items in kind..."/>
                                </group>
                            </group>
                        </page>
                        <page string="Contract Terms" name="contract_terms">
                            <group>
                                <group name="dates" string="Duration">
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="trial_date_end"/>
                                </group>
                                <group name="schedule" string="Work Schedule">
                                    <field name="resource_calendar_id"/>
                                    <field name="permit_no"/>
                                    <field name="visa_no"/>
                                    <field name="visa_expire"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes_page">
                            <field name="notes" placeholder="Internal HR notes about this contract..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- HR Contract List View (Replaces tree) -->
    <record id="hr_contract_view_list" model="ir.ui.view">
        <field name="name">hr.contract.list</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-warning="state == 'pending'" decoration-muted="state in ('close', 'cancel')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="type_id"/>
                <field name="word_template_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="wage" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- HR Contract Kanban View (Modern Odoo 20 card syntax) -->
    <record id="hr_contract_view_kanban" model="ir.ui.view">
        <field name="name">hr.contract.kanban</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="state"/>
                <field name="wage"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column gap-1">
                            <strong class="fs-6 text-primary"><field name="name"/></strong>
                            <div class="fw-bold"><field name="employee_id"/></div>
                            <div class="text-muted small"><field name="job_id"/></div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge rounded-pill bg-light text-dark"><field name="wage" widget="monetary"/></span>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'open': 'success', 'pending': 'warning', 'close': 'danger'}}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action HR Contract -->
    <record id="action_hr_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="search_view_id" ref="hr_contract_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new contract
            </p>
            <p>
                Manage employee contracts, salaries, terms, and export populated Word (.docx) contracts.
            </p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- HR Contract Word Template Views & Actions                        -->
    <!-- ================================================================ -->
    <record id="hr_contract_word_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.word.template.form</field>
        <field name="model">hr.contract.word.template</field>
        <field name="arch" type="xml">
            <form string="Word Contract Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Hợp đồng lao động xác định thời hạn"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions &amp; Merge Placeholders" name="description">
                            <field name="description" widget="text" placeholder="Add usage notes or list placeholders..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_contract_word_template_view_list" model="ir.ui.view">
        <field name="name">hr.contract.word.template.list</field>
        <field name="model">hr.contract.word.template</field>
        <field name="arch" type="xml">
            <list string="Word Contract Templates">
                <field name="name"/>
                <field name="filename"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_hr_contract_word_template" model="ir.actions.act_window">
        <field name="name">Word Contract Templates</field>
        <field name="res_model">hr.contract.word.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload a new Word (.docx) contract template
            </p>
            <p>
                Use Jinja2 placeholders (such as {{ employee_name }}, {{ wage_in_words }}) inside Microsoft Word files to dynamically merge employee and contract information.
            </p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- HR Contract Type Views & Actions                                 -->
    <!-- ================================================================ -->
    <record id="hr_contract_type_view_form" model="ir.ui.view">
        <field name="name">hr.contract.type.form</field>
        <field name="model">hr.contract.type</field>
        <field name="arch" type="xml">
            <form string="Contract Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_contract_type_view_list" model="ir.ui.view">
        <field name="name">hr.contract.type.list</field>
        <field name="model">hr.contract.type</field>
        <field name="arch" type="xml">
            <list string="Contract Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_hr_contract_type" model="ir.actions.act_window">
        <field name="name">Contract Types</field>
        <field name="res_model">hr.contract.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================================================================ -->
    <!-- Menus                                                            -->
    <!-- ================================================================ -->
    <!-- Main Contracts Menu under HR Root -->
    <menuitem
        id="hr_menu_contract"
        name="Contracts"
        action="action_hr_contract"
        parent="hr.menu_hr_root"
        sequence="4"
        groups="hr.group_hr_user"/>

    <!-- Contract Types under Configuration -->
    <menuitem
        id="hr_menu_contract_type"
        name="Contract Types"
        action="action_hr_contract_type"
        parent="hr.menu_human_resources_configuration"
        sequence="20"
        groups="hr.group_hr_manager"/>

    <!-- Word Contract Templates under Configuration -->
    <menuitem
        id="hr_menu_contract_word_template"
        name="Word Templates"
        action="action_hr_contract_word_template"
        parent="hr.menu_human_resources_configuration"
        sequence="21"
        groups="hr.group_hr_manager"/>

</odoo>
