<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View (Odoo 20: <list>) -->
    <record id="view_test_item_list" model="ir.ui.view">
        <field name="name">test.item.list</field>
        <field name="model">test.item</field>
        <field name="arch" type="xml">
            <list string="Danh sách Mục Kiểm Thử">
                <field name="name"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_test_item_form" model="ir.ui.view">
        <field name="name">test.item.form</field>
        <field name="model">test.item</field>
        <field name="arch" type="xml">
            <form string="Mục Kiểm Thử">
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Hoàn thành" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nhập tên mục kiểm thử..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Nhập mô tả chi tiết..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_test_item" model="ir.actions.act_window">
        <field name="name">Mục Kiểm Thử</field>
        <field name="res_model">test.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bấm vào Tạo Mới để tạo mục kiểm thử đầu tiên!
            </p>
        </field>
    </record>
</odoo>
