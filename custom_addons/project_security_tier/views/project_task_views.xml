<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Project Task Form View to manage allocated_hours visibility and readonly state -->
    <record id="view_task_form2_inherited_security_tier" model="ir.ui.view">
        <field name="name">project.task.form.inherited.security.tier</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="before">
                <field name="is_project_leader" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="readonly">id and not is_project_leader</attribute>
                <attribute name="widget">float_time</attribute>
            </xpath>
        </field>
    </record>

</odoo>
