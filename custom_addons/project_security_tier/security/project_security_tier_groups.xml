<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tier 1: Project User (Tiered) -->
    <record id="group_project_tier_user" model="res.groups">
        <field name="name">Project User (Tiered)</field>
        <field name="comment">Tiered Project User: Can only view and update tasks assigned to them or created by them.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Tier 2: Project Leader -->
    <record id="group_project_tier_leader" model="res.groups">
        <field name="name">Project Leader</field>
        <field name="comment">Project Leader: Can manage tasks, adjust allocated hours, and move stages on projects they lead.</field>
        <field name="sequence">15</field>
        <field name="implied_ids" eval="[(4, ref('group_project_tier_user'))]"/>
    </record>

    <!-- Wire Project Administrator to imply Project Leader -->
    <record id="project.group_project_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_project_tier_leader'))]"/>
    </record>

</odoo>
