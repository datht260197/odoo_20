msgid "Only pending requests can be approved."
msgstr "Chỉ lệnh điều xe đang chờ duyệt mới có thể phê duyệt."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Only the department manager of '%(employee)s' or a Frontdesk Manager can approve this request."
msgstr "Chỉ quản lý trực tiếp của '%(employee)s' hoặc Quản lý Hành chính mới có quyền duyệt yêu cầu này."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Only pending requests can be rejected."
msgstr "Chỉ lệnh điều xe đang chờ duyệt mới có thể từ chối."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Only the department manager of '%(employee)s' or a Frontdesk Manager can reject this request."
msgstr "Chỉ quản lý trực tiếp của '%(employee)s' hoặc Quản lý Hành chính mới có quyền từ chối yêu cầu này."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Only approved requests can be dispatched."
msgstr "Chỉ lệnh điều xe đã duyệt mới có thể tiến hành điều xe."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Please assign both a vehicle and a driver before dispatching."
msgstr "Vui lòng phân công cả phương tiện và lái xe trước khi điều xe."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Only dispatched trips can be marked as completed."
msgstr "Chỉ chuyến xe đã xuất phát mới có thể xác nhận hoàn thành."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Please record the End Odometer reading upon trip return."
msgstr "Vui lòng nhập số km kết thúc khi xe trở về."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Cannot cancel requests that are already done or cancelled."
msgstr "Không thể huỷ lệnh điều xe đã hoàn thành hoặc đã bị huỷ trước đó."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_request.py:0
msgid "Only Frontdesk Managers can reset completed or cancelled trips."
msgstr "Chỉ Quản lý Hành chính mới có quyền đặt lại chuyến xe đã hoàn thành hoặc đã huỷ."

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/fleet_dispatch_expense.py:0
msgid "Only Frontdesk Officers or Managers are authorized to mark expenses as Paid."
msgstr "Chỉ Nhân viên Lễ tân hoặc Quản lý Hành chính mới có quyền chuyển trạng thái thanh toán sang Đã thanh toán."
