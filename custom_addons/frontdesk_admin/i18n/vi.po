#. module: frontdesk_admin
#: model:mail.template,body_html:frontdesk_admin.mail_template_visitor_arrived
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 13px;\">\n"
"    <p>Dear <t t-out=\"object.host_id.name or ''\">Colleague</t>,</p>\n"
"    <p>Your guest has arrived and is waiting for you at the frontdesk reception.</p>\n"
"    <table style=\"border-collapse: collapse; width: 100%; max-width: 500px; margin: 15px 0;\">\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Visitor Name:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.name or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Organization:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.company_name or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Phone:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.phone or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Email:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.email or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Purpose:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.purpose or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Meeting Location:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.room_name or 'Reception Desk'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Check-in Time:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"format_datetime(object.checkin_time) or ''\"/></td>\n"
"        </tr>\n"
"    </table>\n"
"    <p>Please meet your visitor at the reception desk.</p>\n"
"    <p>Best regards,<br/><t t-out=\"object.company_id.name or 'Frontdesk Team'\"/></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 13px;\">\n"
"    <p>Kính gửi <t t-out=\"object.host_id.name or ''\">Đồng nghiệp</t>,</p>\n"
"    <p>Khách đến làm việc của bạn đã đến và đang đợi tại văn phòng hành chính.</p>\n"
"    <table style=\"border-collapse: collapse; width: 100%; max-width: 500px; margin: 15px 0;\">\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Tên khách:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.name or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Cơ quan / Đơn vị:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.company_name or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Số điện thoại:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.phone or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Email:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.email or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Mục đích:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.purpose or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Địa điểm họp:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.room_name or 'Văn phòng Hành chính'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Thời gian đến:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"format_datetime(object.checkin_time) or ''\"/></td>\n"
"        </tr>\n"
"    </table>\n"
"    <p>Vui lòng đón khách tại văn phòng hành chính.</p>\n"
"    <p>Trân trọng,<br/><t t-out=\"object.company_id.name or 'Bộ phận Hành chính'\"/></p>\n"
"</div>\n"
"            "

#. module: frontdesk_admin
#: model:mail.template,body_html:frontdesk_admin.mail_template_parcel_received
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 13px;\">\n"
"    <p>Dear <t t-out=\"object.recipient_id.name or ''\">Colleague</t>,</p>\n"
"    <p>A physical parcel has been received for you at the frontdesk.</p>\n"
"    <table style=\"border-collapse: collapse; width: 100%; max-width: 500px; margin: 15px 0;\">\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Parcel Number:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.name or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Tracking Ref:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.tracking_ref or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Carrier:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.carrier_id.name or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Received Time:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"format_datetime(object.received_date) or ''\"/></td>\n"
"        </tr>\n"
"    </table>\n"
"    <t t-if=\"object.delivery_notes\">\n"
"        <p><strong>Handover / Proxy Notes:</strong> <t t-out=\"object.delivery_notes or ''\"/></p>\n"
"    </t>\n"
"    <p>Please present yourself at the frontdesk to collect your package.</p>\n"
"    <p>Best regards,<br/><t t-out=\"object.company_id.name or 'Frontdesk Team'\"/></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 13px;\">\n"
"    <p>Kính gửi <t t-out=\"object.recipient_id.name or ''\">Đồng nghiệp</t>,</p>\n"
"    <p>Một bưu phẩm thực tế đã được tiếp nhận cho bạn tại văn phòng hành chính.</p>\n"
"    <table style=\"border-collapse: collapse; width: 100%; max-width: 500px; margin: 15px 0;\">\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Mã bưu phẩm:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.name or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Mã vận đơn:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.tracking_ref or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Đơn vị vận chuyển:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"object.carrier_id.name or '-'\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 6px; font-weight: bold; border-bottom: 1px solid #ddd;\">Thời gian nhận:</td>\n"
"            <td style=\"padding: 6px; border-bottom: 1px solid #ddd;\"><t t-out=\"format_datetime(object.received_date) or ''\"/></td>\n"
"        </tr>\n"
"    </table>\n"
"    <t t-if=\"object.delivery_notes\">\n"
"        <p><strong>Ghi chú bàn giao / nhận thay:</strong> <t t-out=\"object.delivery_notes or ''\"/></p>\n"
"    </t>\n"
"    <p>Vui lòng đến văn phòng hành chính để nhận bưu phẩm.</p>\n"
"    <p>Trân trọng,<br/><t t-out=\"object.company_id.name or 'Bộ phận Hành chính'\"/></p>\n"
"</div>\n"
"            "

#. module: frontdesk_admin
#. odoo-python
#: code:addons/frontdesk_admin/models/frontdesk_parcel.py:0
msgid ""
"<p>Dear %(name)s,</p><p>A parcel (<b>%(ref)s</b>) has been received for you "
"at the frontdesk.</p><ul><li>Tracking Reference: "
"%(tracking)s</li><li>Carrier: %(carrier)s</li><li>Received Date: "
"%(date)s</li></ul><p>Please contact the frontdesk to collect your "
"parcel.</p>"
msgstr ""
"<p>Kính gửi %(name)s,</p><p>Một bưu phẩm (<b>%(ref)s</b>) đã được tiếp nhận "
"cho bạn tại văn phòng hành chính.</p><ul><li>Mã vận đơn: "
"%(tracking)s</li><li>Đơn vị vận chuyển: %(carrier)s</li><li>Ngày tiếp nhận: "
"%(date)s</li></ul><p>Vui lòng liên hệ văn phòng hành chính để nhận bưu phẩm "
"của bạn.</p>"

