<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Inbound, Contract, Other Documents -->
        <record id="seq_frontdesk_document_inbound" model="ir.sequence">
            <field name="name">Frontdesk Document Inbound</field>
            <field name="code">frontdesk.document.inbound</field>
            <field name="prefix">CVD/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Outbound Documents -->
        <record id="seq_frontdesk_document_outbound" model="ir.sequence">
            <field name="name">Frontdesk Document Outbound</field>
            <field name="code">frontdesk.document.outbound</field>
            <field name="prefix">CVI/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Physical Courier Parcels -->
        <record id="seq_frontdesk_parcel" model="ir.sequence">
            <field name="name">Frontdesk Parcel</field>
            <field name="code">frontdesk.parcel</field>
            <field name="prefix">BP/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Fleet Dispatch Requests -->
        <record id="seq_fleet_dispatch_request" model="ir.sequence">
            <field name="name">Fleet Dispatch Request</field>
            <field name="code">fleet.dispatch.request</field>
            <field name="prefix">DX/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
